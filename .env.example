# URL base de la API NestJS (Boosted), sin barra final.
# La lee solo el servidor (Server Actions y contenedores): NO lleva prefijo NEXT_PUBLIC_.
API_URL=http://localhost:3000

# Fuente de datos activa del módulo dual: rest | graphql
NEXT_PUBLIC_DATA_SOURCE=rest

# URL del servidor WebSocket a la que se conecta el navegador (por defecto, el mismo host de la API)
NEXT_PUBLIC_WS_URL=http://localhost:3000
