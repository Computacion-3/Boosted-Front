# URL base de la API NestJS (Boosted), sin barra final.
# La lee solo el servidor (Server Actions y contenedores): NO lleva prefijo NEXT_PUBLIC_.
# Con el backend desplegado: https://boosted-api.onrender.com
API_URL=http://localhost:3000

# Fuente de datos activa del módulo dual (eventos): rest | graphql
# Next la incrusta al construir: si la cambias, vuelve a ejecutar `npm run build` (o reinicia `npm run dev`).
NEXT_PUBLIC_DATA_SOURCE=rest

# URL del servidor WebSocket a la que se conecta el navegador. Normalmente es la misma que API_URL.
# Es obligatoria para las notificaciones en tiempo real: sin ella la campana avisa que no está configurada.
# También se incrusta al construir (en Vercel, defínela antes del build).
NEXT_PUBLIC_WS_URL=http://localhost:3000

# --- Pruebas E2E (Playwright) ---
# Cuentas de prueba que usa e2e/auth.setup.ts (una por rol: aficionado, moderador y administrador). Pon aquí cuentas de una API de pruebas,
# nunca contraseñas reales. Este archivo se versiona: deja los valores vacíos y llénalos en .env.local.
E2E_AFICIONADO_EMAIL=
E2E_AFICIONADO_PASSWORD=
E2E_MODERADOR_EMAIL=
E2E_MODERADOR_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
# Opcional: URL del front (por defecto http://localhost:3001).
E2E_BASE_URL=
# Opcional: API de pruebas. Si el front no está corriendo, Playwright lo levanta apuntando a esta URL.
E2E_API_URL=
